@startuml Complete_Gift_Sequence
' Сценарий 2: отметка подарка как купленного
' Рендер: plantuml -tpng complete_gift_sequence.puml

title Отметка подарка как купленного

actor "Пользователь" as User
participant "Интерфейс" as UI
participant "API-контроллер" as Controller
participant "Сервис подарков" as GiftService
participant "База данных" as DB
participant "Сервис уведомлений" as NotificationService

User -> UI: Ставит галочку «куплено»
UI -> Controller: PATCH /api/gifts/7\n{status: "bought"}
Controller -> GiftService: markAsBought(gift_id = 7)
GiftService -> DB: UPDATE gifts SET status='bought',\nbought_at=datetime('now')\nWHERE gift_id = 7
DB --> GiftService: rows_affected = 1
GiftService -> GiftService: checkListCompleted(list_id)

alt rows_affected = 1
  GiftService -> DB: SELECT COUNT(*) FROM gifts\nWHERE list_id = 1 AND status <> 'given'
  DB --> GiftService: open_items = 0
  opt все подарки списка закрыты
    GiftService -> NotificationService: notifyListCompleted(list_id = 1)
    NotificationService --> GiftService: notification_id
  end
  GiftService --> Controller: GiftUpdated(status='bought')
  Controller --> UI: 200 OK\n{gift_id, status, bought_at}
  UI -> User: Зачёркивает подарок,\nобновляет счётчики
else rows_affected = 0
  GiftService --> Controller: NotFoundError(gift_id)
  Controller --> UI: 404 Not Found
  UI -> User: Показывает сообщение об ошибке
end

@enduml
