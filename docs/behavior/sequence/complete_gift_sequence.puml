@startuml Complete_Gift_Sequence
' Сценарий 2: отметка подарка как купленного
' Рендер: plantuml -tpng -tsvg complete_gift_sequence.puml

title Отметка подарка как купленного

actor "Пользователь" as User
participant "Интерфейс" as UI
participant "API-контроллер" as Controller
participant "Сервис подарков" as GiftService
participant "База данных" as DB
participant "Сервис уведомлений" as NotificationService

User -> UI: Ставит галочку «куплено»
activate User
activate UI
UI -> Controller: PATCH /api/gifts/{id}\n{status: "bought"}
activate Controller
Controller -> GiftService: markAsBought(gift_id)
activate GiftService
GiftService -> DB: UPDATE gifts\nSET status = 'bought',\nbought_at = datetime('now')\nWHERE gift_id = ?
activate DB
DB --> GiftService: rows_affected
deactivate DB
GiftService -> GiftService: checkListCompleted(list_id)

alt rows_affected = 1
  GiftService -> DB: SELECT COUNT(*) FROM gifts\nWHERE list_id = ? AND status <> 'given'
  activate DB
  DB --> GiftService: open_items
  deactivate DB
  opt все подарки списка закрыты
    GiftService -> NotificationService: notifyListCompleted(list_id)
    activate NotificationService
    NotificationService --> GiftService: notification_id
    deactivate NotificationService
  end
  GiftService --> Controller: GiftUpdated(status='bought')
  deactivate GiftService
  Controller --> UI: 200 OK\n{gift_id, status, bought_at}
  deactivate Controller
  UI -> UI: Зачеркнуть подарок, обновить счётчики
  UI --> User: Показать анимацию выполнения
else rows_affected = 0
  GiftService --> Controller: NotFoundError(gift_id)
  deactivate GiftService
  Controller --> UI: 404 Not Found
  deactivate Controller
  UI --> User: Показать сообщение об ошибке
end

deactivate UI
deactivate User
@enduml
