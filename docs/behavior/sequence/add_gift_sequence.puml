@startuml Add_Gift_Sequence
' Сценарий 1: добавление подарка
' Рендер: plantuml -tpng -tsvg add_gift_sequence.puml

title Добавление подарка

actor "Пользователь" as User
participant "Интерфейс" as UI
participant "API-контроллер" as Controller
participant "Сервис подарков" as GiftService
participant "База данных" as DB

User -> UI: Заполняет форму подарка\n(название, получатель, цена)
activate User
activate UI
UI -> Controller: POST /api/gifts\n{title, recipient_id, price}
activate Controller
Controller -> GiftService: createGift(giftData)
activate GiftService
GiftService -> GiftService: validateGiftData(giftData)

alt Данные валидны
  GiftService -> DB: INSERT INTO gifts\n(user_id, title, price, status, priority)
  activate DB
  DB --> GiftService: gift_id
  deactivate DB
  GiftService -> DB: SELECT limit_amount, spent\nFROM v_budget_usage
  activate DB
  DB --> GiftService: budget_remaining
  deactivate DB
  GiftService --> Controller: GiftResponse(gift_id, budget_warning)
  deactivate GiftService
  Controller --> UI: 201 Created\n{gift_id, budget_warning}
  deactivate Controller
  UI -> UI: Показать уведомление "Подарок добавлен"
  UI -> UI: Обновить список и счётчики
  UI --> User: Отобразить новый подарок в списке
else Данные невалидны
  GiftService --> Controller: ErrorResponse("Неверные данные")
  deactivate GiftService
  Controller --> UI: 400 Bad Request\n{error_message}
  deactivate Controller
  UI --> User: Показать ошибку валидации
end

deactivate UI
deactivate User
@enduml
